<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProvaVida.Maui.Pages.PerfilPage"
             Title="Meu Perfil"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Top bar com hamburger — mesmo padrão da CheckInPage -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16,12,20,12">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="☰"
                           FontSize="22"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHamburgerTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1"
                           Text="Meu Perfil"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Header -->
            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                    Padding="20,48,20,28">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 48"
                            StrokeThickness="0"
                            WidthRequest="96" HeightRequest="96"
                            HorizontalOptions="Center">
                        <Label Text="{Binding Inicial}" FontSize="36" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding Nome}" FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding Email}" FontSize="13"
                           TextColor="White" Opacity="0.8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20,20,20,8" Spacing="16">

                <!-- Card dados pessoais -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                        StrokeThickness="0" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Dados pessoais" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nome" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Border Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5" Padding="16,0" HeightRequest="52">
                                <Entry Text="{Binding Nome}" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="WhatsApp" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Border Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5" Padding="16,0" HeightRequest="52">
                                <Entry Text="{Binding WhatsApp}" Keyboard="Telephone" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Card contato emergência -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                        StrokeThickness="0" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Contato de emergência" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nome" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Border Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5" Padding="16,0" HeightRequest="52">
                                <Entry Text="{Binding ContatoNome}" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="E-mail" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Border Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5" Padding="16,0" HeightRequest="52">
                                <Entry Text="{Binding ContatoEmail}" Keyboard="Email" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="WhatsApp" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Border Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5" Padding="16,0" HeightRequest="52">
                                <Entry Text="{Binding ContatoWhatsApp}" Keyboard="Telephone" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Erro -->
                <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="13"
                       IsVisible="{Binding HasError}" HorizontalOptions="Center"/>

                <!-- Botão Salvar -->
                <Button Text="Salvar alterações" Command="{Binding SalvarCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        CornerRadius="14" HeightRequest="52" FontSize="16" FontAttributes="Bold"/>

                <!-- Botão Alterar Senha -->
                <Button Text="Alterar senha" Command="{Binding AlterarSenhaCommand}"
                        BackgroundColor="White" TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}" BorderWidth="1.5"
                        CornerRadius="14" HeightRequest="48" FontSize="15"/>

                <!-- Botão Logoff -->
                <Button Text="Sair da conta" Command="{Binding LogoffCommand}"
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Border}" BorderWidth="1.5"
                        CornerRadius="14" HeightRequest="48" FontSize="15"/>

                <!-- Botão Excluir -->
                <Button Text="Excluir minha conta" Command="{Binding ExcluirContaCommand}"
                        BackgroundColor="{StaticResource DangerLight}"
                        TextColor="{StaticResource Danger}"
                        BorderColor="{StaticResource Danger}" BorderWidth="1"
                        CornerRadius="12" HeightRequest="48" FontSize="15" Margin="0,0,0,24"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
