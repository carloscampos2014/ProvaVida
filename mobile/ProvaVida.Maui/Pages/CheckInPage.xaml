<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProvaVida.Maui.Pages.CheckInPage"
             Title="ProvaVida"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Linha 0: Top bar + Card sequência removido — lista de check-ins na parte inferior -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <!-- Top bar -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16,12,20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Botão hamburger -->
                    <Label Grid.Column="0"
                           Text="☰"
                           FontSize="22"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHamburgerTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Saudação -->
                    <Label Grid.Column="1"
                           Text="{Binding NomeUsuario, StringFormat='Olá, {0} 👋'}"
                           FontSize="16"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center"/>
                    <!-- Ícone de perfil -->
                    <Label Grid.Column="2"
                           x:Name="TopBarAvatar"
                           FontSize="22"
                           VerticalOptions="Center"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>



        </VerticalStackLayout>

        <!-- Linha 1: Botão principal centralizado -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="0">

            <Border BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeShape="RoundRectangle 100"
                    StrokeThickness="0"
                    WidthRequest="200" HeightRequest="200"
                    HorizontalOptions="Center">
                <Border BackgroundColor="{Binding FezCheckInHoje, Converter={StaticResource BoolToColorConverter}}"
                        StrokeShape="RoundRectangle 88"
                        StrokeThickness="0"
                        WidthRequest="176" HeightRequest="176"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CheckInCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="✓" FontSize="44" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding FezCheckInHoje, Converter={StaticResource BoolToCheckInTextConverter}}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Border>

        </VerticalStackLayout>

        <!-- Linha 2: Bottom — hint, erro, loading, card da semana -->
        <VerticalStackLayout Grid.Row="2" Padding="20,16,20,32" Spacing="16">

            <!-- Hint -->
            <Label FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Text="{Binding FezCheckInHoje, Converter={StaticResource BoolToCheckInHintConverter}}"/>

            <!-- Erro -->
            <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="13"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center"/>

            <!-- Card histórico de check-ins recentes -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                    StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.06"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Check-ins recentes" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <!-- Altura fixa para ~3 itens visíveis, scroll para ver mais -->
                    <CollectionView ItemsSource="{Binding CheckInsRecentes}"
                                    HeightRequest="168">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum check-in registrado"
                                   FontSize="13"
                                   TextColor="{StaticResource TextHint}"
                                   HorizontalOptions="Center"
                                   Margin="0,16,0,0"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            WidthRequest="28" HeightRequest="28"
                                            Margin="0,0,12,0">
                                        <Label Text="✓" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
