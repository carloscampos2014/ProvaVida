<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProvaVida.Maui.Pages.CheckInPage"
             Title="ProvaVida"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Linha 0: Top bar + Card sequência -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <!-- Top bar -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16,12,20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Botão hamburger -->
                    <Label Grid.Column="0"
                           Text="☰"
                           FontSize="22"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHamburgerTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- Saudação -->
                    <Label Grid.Column="1"
                           Text="{Binding NomeUsuario, StringFormat='Olá, {0} 👋'}"
                           FontSize="16"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center"/>
                    <!-- Ícone de perfil -->
                    <Label Grid.Column="2"
                           x:Name="TopBarAvatar"
                           FontSize="22"
                           VerticalOptions="Center"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Card sequência -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                    StrokeThickness="0" Padding="20" Margin="20,12,20,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.06"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Sequência" FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="{Binding SequenciaDias, StringFormat='{0} dias consecutivos'}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"/>
                        <Label Text="com check-in ✓" FontSize="13"
                               TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            WidthRequest="56" HeightRequest="56">
                        <Label Text="🔥" FontSize="22"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- Linha 1: Botão principal centralizado -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="0">

            <Border BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeShape="RoundRectangle 126"
                    StrokeThickness="0"
                    WidthRequest="252" HeightRequest="252"
                    HorizontalOptions="Center">
                <Border BackgroundColor="{Binding FezCheckInHoje, Converter={StaticResource BoolToColorConverter}}"
                        StrokeShape="RoundRectangle 110"
                        StrokeThickness="0"
                        WidthRequest="220" HeightRequest="220"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CheckInCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="✓" FontSize="52" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding FezCheckInHoje, Converter={StaticResource BoolToCheckInTextConverter}}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Border>

        </VerticalStackLayout>

        <!-- Linha 2: Bottom — hint, erro, loading, card da semana -->
        <VerticalStackLayout Grid.Row="2" Padding="20,16,20,32" Spacing="16">

            <!-- Hint -->
            <Label FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Text="{Binding FezCheckInHoje, Converter={StaticResource BoolToCheckInHintConverter}}"/>

            <!-- Erro -->
            <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="13"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center"/>

            <!-- Card histórico da semana -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                    StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.06"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Esta semana" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <HorizontalStackLayout x:Name="SemanaLayout" Spacing="8"
                                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Botão de teste de notificação — remover após confirmar funcionamento -->
            <Button x:Name="BtnTestarNotificacao"
                    Text="🔔 Testar Notificação (5s)"
                    Margin="0,8,0,0"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="13"
                    Clicked="OnTestarNotificacaoTapped"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
