<?xml version="1.0" encoding="utf-8"?>
<!--
    Shortcuts estáticos — sempre visíveis independente do estado do app.
    Os shortcuts dinâmicos (que variam conforme login/check-in) são
    gerenciados pelo AppShortcutsService via ShortcutManager.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shortcut estático: abrir o app -->
    <shortcut
        android:shortcutId="abrir_app"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_abrir"
        android:shortcutLongLabel="@string/shortcut_abrir_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.enzojb.provavida"
            android:targetClass="com.enzojb.provavida.MainActivity" />
    </shortcut>
</shortcuts>
