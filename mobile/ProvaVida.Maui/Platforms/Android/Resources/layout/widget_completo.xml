<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Completo ProvaVida — 4x2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_completo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Título + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ProvaVida"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#774CCC" />

        <TextView
            android:id="@+id/widget_completo_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#2E9E6B" />

    </LinearLayout>

    <!-- Linha de dias da semana -->
    <LinearLayout
        android:id="@+id/widget_completo_semana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Os 7 dias são adicionados programaticamente pelo provider -->
        <TextView android:id="@+id/dia_0" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="D" />
        <TextView android:id="@+id/dia_1" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="S" />
        <TextView android:id="@+id/dia_2" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="T" />
        <TextView android:id="@+id/dia_3" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Q" />
        <TextView android:id="@+id/dia_4" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Q" />
        <TextView android:id="@+id/dia_5" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="S" />
        <TextView android:id="@+id/dia_6" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textColor="#FFFFFF" android:text="S" />

    </LinearLayout>

    <!-- Label de ação -->
    <TextView
        android:id="@+id/widget_completo_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque para fazer check-in"
        android:textSize="10sp"
        android:textColor="#6E648B"
        android:gravity="center"
        android:layout_marginTop="6dp" />

</LinearLayout>
