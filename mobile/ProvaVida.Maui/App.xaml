<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ProvaVida.Maui"
             xmlns:converters="clr-namespace:ProvaVida.Maui.Converters"
             x:Class="ProvaVida.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToCheckInTextConverter x:Key="BoolToCheckInTextConverter"/>
            <converters:BoolToCheckInHintConverter x:Key="BoolToCheckInHintConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
