<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ProvaVida.Maui.Pages"
       x:Class="ProvaVida.Maui.AppShell"
       Shell.NavBarIsVisible="False"
       FlyoutBackgroundColor="#FFFFFF">

    <!-- Header do flyout com avatar e nome do usuário -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#774CCC"
              Padding="20,48,20,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Border Grid.Row="0"
                    BackgroundColor="#EFE9FB"
                    StrokeShape="RoundRectangle 36"
                    StrokeThickness="0"
                    WidthRequest="72" HeightRequest="72"
                    HorizontalOptions="Start">
                <Label x:Name="FlyoutAvatar"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="#774CCC"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Row="1" x:Name="FlyoutNome"
                   FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF"/>
            <Label Grid.Row="2" x:Name="FlyoutEmail"
                   FontSize="13" TextColor="#FFFFFF" Opacity="0.8"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Rotas sem item no flyout (loading, login, cadastro) -->
    <ShellContent Route="loading"
                  ContentTemplate="{DataTemplate pages:LoadingPage}"
                  FlyoutItemIsVisible="False"/>

    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate pages:LoginPage}"
                  FlyoutItemIsVisible="False"/>

    <ShellContent Route="cadastro"
                  ContentTemplate="{DataTemplate pages:CadastroPage}"
                  FlyoutItemIsVisible="False"/>

    <!-- Rotas visíveis no flyout -->
    <FlyoutItem Title="Check-in" Icon="🏠" Route="checkin">
        <ShellContent ContentTemplate="{DataTemplate pages:CheckInPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Meu Perfil" Icon="👤" Route="perfil">
        <ShellContent ContentTemplate="{DataTemplate pages:PerfilPage}"/>
    </FlyoutItem>

</Shell>
