<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ProvaVida.Maui.Pages"
       x:Class="ProvaVida.Maui.AppShell"
       Shell.NavBarIsVisible="False"
       FlyoutBehavior="Disabled">

    <!-- LoadingPage como rota inicial — verifica sessao antes de exibir login ou checkin -->
    <ShellContent Route="loading"
                  ContentTemplate="{DataTemplate pages:LoadingPage}"/>

    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate pages:LoginPage}"/>

    <ShellContent Route="cadastro"
                  ContentTemplate="{DataTemplate pages:CadastroPage}"/>

    <ShellContent Route="checkin"
                  ContentTemplate="{DataTemplate pages:CheckInPage}"/>

    <ShellContent Route="perfil"
                  ContentTemplate="{DataTemplate pages:PerfilPage}"/>

</Shell>
