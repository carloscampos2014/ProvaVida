<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta ProvaVida — Roxo -->
    <Color x:Key="Primary">#774CCC</Color>
    <Color x:Key="PrimaryDark">#57329F</Color>
    <Color x:Key="PrimaryLight">#EFE9FB</Color>
    <Color x:Key="PrimaryMid">#9C74E0</Color>

    <Color x:Key="Danger">#E73C3C</Color>
    <Color x:Key="DangerLight">#FEE5E5</Color>

    <Color x:Key="TextPrimary">#1E1930</Color>
    <Color x:Key="TextSecondary">#6E648B</Color>
    <Color x:Key="TextHint">#B2ACC6</Color>

    <Color x:Key="Border">#E4E0F2</Color>
    <Color x:Key="Surface">#F8F7FD</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- Cores do sistema MAUI (usadas pelo Styles.xaml padrão) -->
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkText">#9C9C9C</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>

</ResourceDictionary>
