<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProvaVida.Mobile.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProvaVida.Mobile.App"
    xmlns:pages="clr-namespace:ProvaVida.Mobile.App.Pages"
    Title="Enzojb Prova de Vida">

    <!-- LoginPage: rota inicial padrão — OnStart navega para Check-in se já logado -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Title="Início"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Cadastro"
        ContentTemplate="{DataTemplate pages:CadastroPage}"
        Route="CadastroPage"
        Shell.NavBarIsVisible="False" />

</Shell>
