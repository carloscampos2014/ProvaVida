<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProvaVida.Mobile.App.ViewModels"
    x:Class="ProvaVida.Mobile.App.Pages.LoginPage"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout
            Padding="32,48,32,32"
            Spacing="0"
            VerticalOptions="Center">

            <!-- Logo / Cabeçalho -->
            <VerticalStackLayout
                Spacing="8"
                Margin="0,0,0,40">

                <Image
                    Source="appicon.png"
                    HeightRequest="72"
                    WidthRequest="72"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Logo Prova de Vida" />

                <Label
                    Text="Prova de Vida"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}"
                    HorizontalOptions="Center"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Entre na sua conta"
                    FontSize="15"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalOptions="Center"
                    SemanticProperties.HeadingLevel="Level2" />

            </VerticalStackLayout>

            <!-- Campo E-mail -->
            <Label
                Text="E-mail"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                Margin="0,0,0,6" />

            <Border
                StrokeShape="RoundRectangle 10"
                Stroke="{StaticResource Border}"
                StrokeThickness="1.5"
                BackgroundColor="{StaticResource White}"
                Padding="14,0"
                Margin="0,0,0,16"
                HeightRequest="52">
                <Entry
                    Text="{Binding Email}"
                    Placeholder="seu@email.com"
                    PlaceholderColor="{StaticResource TextHint}"
                    TextColor="{StaticResource TextPrimary}"
                    Keyboard="Email"
                    ReturnType="Next"
                    BackgroundColor="Transparent"
                    FontSize="15"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Hint="Campo de e-mail" />
            </Border>

            <!-- Campo Senha -->
            <Label
                Text="Senha"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                Margin="0,0,0,6" />

            <Border
                StrokeShape="RoundRectangle 10"
                Stroke="{StaticResource Border}"
                StrokeThickness="1.5"
                BackgroundColor="{StaticResource White}"
                Padding="14,0"
                Margin="0,0,0,8"
                HeightRequest="52">
                <Entry
                    Text="{Binding Senha}"
                    Placeholder="Sua senha"
                    PlaceholderColor="{StaticResource TextHint}"
                    TextColor="{StaticResource TextPrimary}"
                    IsPassword="True"
                    ReturnType="Done"
                    ReturnCommand="{Binding LoginCommand}"
                    BackgroundColor="Transparent"
                    FontSize="15"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    SemanticProperties.Hint="Campo de senha" />
            </Border>

            <!-- Mensagem de erro -->
            <Border
                IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}"
                StrokeShape="RoundRectangle 8"
                Stroke="{StaticResource Danger}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource DangerLight}"
                Padding="12,10"
                Margin="0,8,0,0">
                <Label
                    Text="{Binding MensagemErro}"
                    TextColor="{StaticResource Danger}"
                    FontSize="13" />
            </Border>

            <!-- Botão Entrar -->
            <Button
                Text="Entrar"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="52"
                Margin="0,24,0,0"
                SemanticProperties.Hint="Botão de login" />

            <!-- ActivityIndicator -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{StaticResource Primary}"
                Margin="0,12,0,0"
                HorizontalOptions="Center" />

            <!-- Link Criar Conta -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4"
                Margin="0,28,0,0">
                <Label
                    Text="Não tem uma conta?"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />
                <Label
                    Text="Criar conta"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
