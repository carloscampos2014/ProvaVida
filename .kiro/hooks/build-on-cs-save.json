{
  "version": "v1",
  "hooks": [
    {
      "name": "Build ao Salvar C# Backend",
      "trigger": "PostFileSave",
      "matcher": "src.*\\.cs$",
      "action": {
        "type": "command",
        "command": "dotnet build \"c:\\Dev\\ProvaVida\\src\\ProvaVida.Api\\ProvaVida.Api.csproj\" --no-restore -v quiet 2>&1 | Select-Object -Last 5",
        "timeout": 60
      }
    }
  ]
}